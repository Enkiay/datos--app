      "id": "estructura_aporticada",
      "nombre": "Estructura aporticada (zapatas + columnas + vigas + losa)",
      "descripcion": "Genera el sistema estructural completo para un rectángulo de ejeX × ejeY con grilla modular luzX × luzY. Calcula columnas, vigas en ambos sentidos, zapatas y losa de techo. Una sola ejecución por nivel.",
      "premium": false,
      "version": 1,
      "deprecated": false,
