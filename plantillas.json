          "unidad": "m3",
          "formulaTexto": "ejeX * ejeY * espesorLosa",
          "lee": ["ejeX", "ejeY", "espesorLosa"],
          "escribe": "volLosa"
        },
        {
          "id": "encofrado_columnas",
          "nombre": "Encofrado de columnas",
          "catalogoCodigo": "UH010",
          "unidad": "m2",
          "formulaTexto": "(ceil(ejeX/luzX) + 1) * (ceil(ejeY/luzY) + 1) * 4 * sqrt(seccionColumnaArea) * alturaPiso",
          "lee": ["ejeX", "ejeY", "luzX", "luzY", "seccionColumnaArea", "alturaPiso"],
          "escribe": "areaEncColumnas"
        },
