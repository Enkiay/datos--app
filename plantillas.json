        { "nombre": "lzZapata", "label": "Lado zapata aislada", "unidad": "m", "default": 1.0, "min": 0.6, "max": 2.0 },
        { "nombre": "espesorZapata", "label": "Espesor zapata", "unidad": "m", "default": 0.30, "min": 0.20, "max": 0.50 }
      ],
      "items": [
        {
          "id": "replanteo",
          "nombre": "Replanteo y trazado",
          "catalogoCodigo": "OG-001",
          "unidad": "m2",
          "formulaTexto": "ejeX * ejeY",
          "lee": ["ejeX", "ejeY"],
          "escribe": "areaPlanta"
        },
        {
          "id": "excavacion_zapatas",
          "nombre": "Excavación para zapatas",
          "catalogoCodigo": "OG-010",
          "unidad": "m3",
          "formulaTexto": "(ceil(ejeX/luzX) + 1) * (ceil(ejeY/luzY) + 1) * lzZapata * lzZapata * (espesorZapata + 0.10)",
          "lee": ["ejeX", "ejeY", "luzX", "luzY", "lzZapata", "espesorZapata"],
          "escribe": "volExcavacion"
        },
        {
          "id": "zapatas",
          "nombre": "Zapata aislada H°A°",
          "catalogoCodigo": "OG-020",
          "unidad": "m3",
          "formulaTexto": "(ceil(ejeX/luzX) + 1) * (ceil(ejeY/luzY) + 1) * lzZapata * lzZapata * espesorZapata",
          "lee": ["ejeX", "ejeY", "luzX", "luzY", "lzZapata", "espesorZapata"],
          "escribe": "volZapatas"
        },
        {
          "id": "columnas",
          "nombre": "Columnas H°A°",
          "catalogoCodigo": "OG-030",
          "unidad": "m3",
          "formulaTexto": "(ceil(ejeX/luzX) + 1) * (ceil(ejeY/luzY) + 1) * seccionColumnaArea * alturaPiso",
          "lee": ["ejeX", "ejeY", "luzX", "luzY", "seccionColumnaArea", "alturaPiso"],
          "escribe": "volColumnas"
        },
        {
          "id": "vigas_x",
          "nombre": "Vigas H°A° en eje X (longitudinales)",
          "catalogoCodigo": "OG-040",
          "unidad": "m3",
          "formulaTexto": "(ceil(ejeY/luzY) + 1) * ejeX * seccionVigaArea",
          "lee": ["ejeX", "ejeY", "luzY", "seccionVigaArea"],
          "escribe": "volVigasX"
        },
        {
          "id": "vigas_y",
          "nombre": "Vigas H°A° en eje Y (transversales)",
          "catalogoCodigo": "OG-040",
          "unidad": "m3",
          "formulaTexto": "(ceil(ejeX/luzX) + 1) * ejeY * seccionVigaArea",
          "lee": ["ejeX", "ejeY", "luzX", "seccionVigaArea"],
          "escribe": "volVigasY"
        },
        {
          "id": "losa",
          "nombre": "Losa maciza H°A°",
          "catalogoCodigo": "OG-050",
          "unidad": "m3",
          "formulaTexto": "ejeX * ejeY * espesorLosa",
          "lee": ["ejeX", "ejeY", "espesorLosa"],
          "escribe": "volLosa"
        },
        {
          "id": "encofrado_columnas",
          "nombre": "Encofrado de columnas",
          "catalogoCodigo": "OG-031",
          "unidad": "m2",
          "formulaTexto": "(ceil(ejeX/luzX) + 1) * (ceil(ejeY/luzY) + 1) * 4 * sqrt(seccionColumnaArea) * alturaPiso",
          "lee": ["ejeX", "ejeY", "luzX", "luzY", "seccionColumnaArea", "alturaPiso"],
          "escribe": "areaEncColumnas"
        },
        {
          "id": "encofrado_losa",
          "nombre": "Encofrado de losa",
          "catalogoCodigo": "OG-051",
          "unidad": "m2",
          "formulaTexto": "ejeX * ejeY",
          "lee": ["ejeX", "ejeY"],
          "escribe": "areaEncLosa"
        }
      ]
    }
  ]
