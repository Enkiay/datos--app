        {
          "id": "zapatas",
          "nombre": "Zapata aislada H°A°",
          "catalogoCodigo": "UH006",
          "unidad": "m3",
          "formulaTexto": "(ceil(ejeX/luzX) + 1) * (ceil(ejeY/luzY) + 1) * lzZapata * lzZapata * espesorZapata",
          "lee": ["ejeX", "ejeY", "luzX", "luzY", "lzZapata", "espesorZapata"],
          "escribe": "volZapatas"
        },
        {
          "id": "columnas",
          "nombre": "Columnas H°A°",
          "catalogoCodigo": "UH007",
          "unidad": "m3",
          "formulaTexto": "(ceil(ejeX/luzX) + 1) * (ceil(ejeY/luzY) + 1) * seccionColumnaArea * alturaPiso",
          "lee": ["ejeX", "ejeY", "luzX", "luzY", "seccionColumnaArea", "alturaPiso"],
          "escribe": "volColumnas"
        },
        {
          "id": "vigas_x",
          "nombre": "Vigas H°A° en eje X (longitudinales)",
          "catalogoCodigo": "UH012",
          "unidad": "m3",
          "formulaTexto": "(ceil(ejeY/luzY) + 1) * ejeX * seccionVigaArea",
          "lee": ["ejeX", "ejeY", "luzY", "seccionVigaArea"],
          "escribe": "volVigasX"
        },
        {
          "id": "vigas_y",
          "nombre": "Vigas H°A° en eje Y (transversales)",
          "catalogoCodigo": "UH012",
          "unidad": "m3",
          "formulaTexto": "(ceil(ejeX/luzX) + 1) * ejeY * seccionVigaArea",
          "lee": ["ejeX", "ejeY", "luzX", "seccionVigaArea"],
          "escribe": "volVigasY"
