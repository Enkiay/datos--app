{
  "version": "4.0",
  "plantillas": [
    {
      "id": "cerramiento-perimetral",
      "version": 13,
      "premium": false,
      "nombre": "Cerramiento Perimetral",
      "descripcion": "Muro perimetral de ladrillo de 6 huecos sobre cimiento corrido de H°C°. Soporta 5 geometrías: Lineal (un solo tramo), L (dos tramos), U (tres tramos), Cerrado (perímetro rectangular completo) o Polígono libre (forma irregular con esquinas configuradas manualmente). Las esquinas se calculan automáticamente según la forma; agrega esquinas adicionales si tu geometría tiene más quiebres. Incluye excavación de zanjas, capa de hormigón pobre (40×5 cm), cimiento corrido (40×40 cm), sobrecimiento (20×30 cm), zapatas de H°A° (40×40×30 cm) y columnas de H°A° (20×20 cm). Las aberturas para portones vehiculares y puertas peatonales descuentan automáticamente del muro y sobrecimiento; la fundación (excavación, capa de H°P°, cimiento corrido) continúa bajo las aberturas.",
      "diagrama": "",
      "inputsRequeridos": [
        {
          "nombre": "tipo_geometria",
          "label": "Forma del cerco",
          "unidad": "",
          "default": 4.0,
          "opciones": [
            { "valor": 1.0, "label": "Lineal" },
            { "valor": 2.0, "label": "L" },
            { "valor": 3.0, "label": "U" },
            { "valor": 4.0, "label": "Cerrado" },
            { "valor": 5.0, "label": "Polígono libre" }
          ]
        },
        {
          "nombre": "longitud_total",
          "label": "Longitud total del muro",
          "unidad": "m",
          "default": 0.0
        },
        {
          "nombre": "altura_muro",
          "label": "Altura del muro",
          "unidad": "m",
          "default": 2.5
        },
        {
          "nombre": "lado_mayor",
          "label": "Lado mayor",
          "unidad": "m",
          "default": 0.0,
          "min": 0.0,
          "visibleSi": "and(tipo_geometria != 1, tipo_geometria != 5)",
          "defaultFormula": "if(tipo_geometria == 4, longitud_total / 4, if(or(tipo_geometria == 2, tipo_geometria == 3), longitud_total / 2, 0))"
        }
      ],
      "parametrosEditables": [
        {
          "nombre": "numero_portones",
          "label": "Portones vehiculares",
          "unidad": "und",
          "default": 1.0,
          "min": 0.0,
          "max": 4.0
        },
        {
          "nombre": "ancho_porton",
          "label": "Ancho de portón",
          "unidad": "m",
          "default": 3.60,
          "min": 2.0,
          "max": 6.0
        },
        {
          "nombre": "alto_porton",
          "label": "Alto de portón",
          "unidad": "m",
          "default": 2.40,
          "min": 1.80,
          "max": 3.0
        },
        {
          "nombre": "numero_puertas",
          "label": "Puertas peatonales",
          "unidad": "und",
          "default": 1.0,
          "min": 0.0,
          "max": 6.0
        },
        {
          "nombre": "ancho_puerta",
          "label": "Ancho de puerta",
          "unidad": "m",
          "default": 1.0,
          "min": 0.70,
          "max": 1.20
        },
        {
          "nombre": "alto_puerta",
          "label": "Alto de puerta",
          "unidad": "m",
          "default": 2.10,
          "min": 1.80,
          "max": 2.50
        },
        {
          "nombre": "esquinas_extra",
          "label": "Esquinas adicionales",
          "unidad": "und",
          "default": 0.0,
          "min": 0.0,
          "max": 16.0
        },
        {
          "nombre": "separacion_columnas",
          "label": "Separación entre columnas",
          "unidad": "m",
          "default": 4.0,
          "min": 2.0,
          "max": 6.0
        },
        {
          "nombre": "h_sobrecimiento",
          "label": "Altura sobrecimiento",
          "unidad": "m",
          "default": 0.30,
          "min": 0.20,
          "max": 0.60
        },
        {
          "nombre": "h_zapata",
          "label": "Altura zapata",
          "unidad": "m",
          "default": 0.30,
          "min": 0.20,
          "max": 0.50
        },
        {
          "nombre": "prof_zanja",
          "label": "Profundidad zanja cimiento",
          "unidad": "m",
          "default": 0.60,
          "min": 0.40,
          "max": 1.50
        },
        {
          "nombre": "prof_zapata",
          "label": "Profundidad fondo zapata (incl. HP)",
          "unidad": "m",
          "default": 0.85,
          "min": 0.40,
          "max": 1.80
        }
      ],
      "variablesCalculadas": {
        "esquinas_implicitas": "if(tipo_geometria == 1, 0, if(tipo_geometria == 2, 1, if(tipo_geometria == 3, 2, if(tipo_geometria == 4, 4, 0))))",
        "esquinas_efectivas": "esquinas_implicitas + esquinas_extra",
        "extremos_abiertos": "if(or(tipo_geometria == 4, tipo_geometria == 5), 0, 1)"
      },
      "items": [
        {
          "id": "excavacion",
          "nombre": "Excavación de zanjas",
          "unidad": "m3",
          "formulaTexto": "longitud_total",
          "lee": ["longitud_total", "esquinas_efectivas", "prof_zanja"],
          "escribe": "ml_excavacion",
          "catalogoCodigo": "UH002",
          "computedOverrides": { "ancho": "0.40", "profundidad": "prof_zanja" },
          "descuentos": [
            { "nombre": "Esquinas", "factorFormula": "esquinas_efectivas", "overrides": { "largo": "0.40", "profundidad": "prof_zanja" } }
          ]
        },
        {
          "id": "exc_zapatas",
          "nombre": "Excavación adicional para zapatas",
          "unidad": "m3",
          "formulaTexto": "cantidad_columnas",
          "lee": ["cantidad_columnas", "prof_zapata", "prof_zanja"],
          "escribe": "cant_exc_zapatas",
          "catalogoCodigo": "UH002",
          "condicionInclusion": "if(prof_zapata > prof_zanja, 1, 0)",
          "computedOverrides": { "largo": "0.40", "ancho": "0.40", "profundidad": "max(0, prof_zapata - prof_zanja)" }
        },
        {
          "id": "hp_capa",
          "nombre": "Capa de hormigón pobre",
          "unidad": "m3",
          "formulaTexto": "longitud_total",
          "lee": ["longitud_total", "esquinas_efectivas"],
          "escribe": "ml_hp",
          "catalogoCodigo": "UH003",
          "presetNombre": "40×5cm",
          "descuentos": [
            { "nombre": "Esquinas", "factorFormula": "esquinas_efectivas", "overrides": { "largo": "0.40" } }
          ]
        },
        {
          "id": "zapatas",
          "nombre": "Zapata de H°A°",
          "unidad": "m3",
          "formulaTexto": "cantidad_columnas",
          "lee": ["cantidad_columnas", "h_zapata"],
          "escribe": "cantidad_zapatas",
          "catalogoCodigo": "UH006",
          "presetNombre": "40×40×30",
          "computedOverrides": { "espesor": "h_zapata" }
        },
        {
          "id": "cimiento",
          "nombre": "Cimiento corrido",
          "unidad": "m3",
          "formulaTexto": "longitud_total",
          "lee": ["longitud_total", "esquinas_efectivas", "cantidad_columnas", "h_zapata", "prof_zapata", "prof_zanja"],
          "escribe": "ml_cimiento",
          "catalogoCodigo": "UH004",
          "presetNombre": "40×40",
          "descuentos": [
            { "nombre": "Esquinas", "factorFormula": "esquinas_efectivas", "overrides": { "largo": "0.40" } },
            { "nombre": "Zapatas (intersección)", "factorFormula": "if(prof_zapata <= prof_zanja, cantidad_columnas, 0)", "overrides": { "largo": "0.40", "altura": "h_zapata" } }
          ]
        },
        {
          "id": "columnas",
          "nombre": "Columna de H°A°",
          "unidad": "m3",
          "formulaTexto": "max(esquinas_efectivas, ceil(longitud_total / separacion_columnas)) + extremos_abiertos",
          "lee": ["longitud_total", "separacion_columnas", "altura_muro", "h_sobrecimiento", "prof_zapata", "extremos_abiertos", "esquinas_efectivas"],
          "escribe": "cantidad_columnas",
          "catalogoCodigo": "UH007",
          "presetNombre": "20×20",
          "computedOverrides": { "altura": "altura_muro + h_sobrecimiento + (prof_zapata - 0.05)" }
        },
        {
          "id": "sobrecimiento",
          "nombre": "Sobrecimiento",
          "unidad": "m3",
          "formulaTexto": "longitud_total",
          "lee": ["longitud_total", "esquinas_efectivas", "numero_portones", "ancho_porton", "numero_puertas", "ancho_puerta"],
          "escribe": "ml_sobrecimiento",
          "catalogoCodigo": "UH005",
          "presetNombre": "20×30",
          "computedOverrides": { "altura": "h_sobrecimiento" },
          "descuentos": [
            { "nombre": "Esquinas", "factorFormula": "esquinas_efectivas", "overrides": { "largo": "0.20" } },
            { "nombre": "Portones", "factorFormula": "numero_portones", "overrides": { "largo": "ancho_porton" } },
            { "nombre": "Puertas", "factorFormula": "numero_puertas", "overrides": { "largo": "ancho_puerta" } }
          ]
        },
        {
          "id": "muro",
          "nombre": "Muro de ladrillo 6H",
          "unidad": "m2",
          "formulaTexto": "longitud_total * altura_muro",
          "lee": ["longitud_total", "altura_muro", "cantidad_columnas", "numero_portones", "ancho_porton", "alto_porton", "numero_puertas", "ancho_puerta", "alto_puerta"],
          "escribe": "area_muro",
          "catalogoCodigo": "UH009",
          "descuentos": [
            { "nombre": "Columnas", "factorFormula": "cantidad_columnas", "overrides": { "largo": "0.20", "ancho": "altura_muro" } },
            { "nombre": "Portones", "factorFormula": "numero_portones", "overrides": { "largo": "ancho_porton", "ancho": "min(alto_porton, altura_muro)" } },
            { "nombre": "Puertas", "factorFormula": "numero_puertas", "overrides": { "largo": "ancho_puerta", "ancho": "min(alto_puerta, altura_muro)" } }
          ]
        }
      ],
      "aceroConfig": {
        "diametroLongitudinal": 10.0,
        "diametroEstribo": 6.0,
        "barrasPorColumna": 4,
        "separacionEstribos": 0.20,
        "recubrimiento": 0.025,
        "doblez": 0.20,
        "ganchoEstribo": 0.06,
        "longitudBarraComercial": 6.0
      },
      "zapataAceroConfig": {
        "diametro": 10.0,
        "separacion": 0.10,
        "recubrimiento": 0.02,
        "doblez": 0.20,
        "longitudBarraComercial": 6.0
      }
    },
    {
      "id": "losa-entrepiso",
      "premium": false,
      "nombre": "Losa Alivianada de Entrepiso",
      "descripcion": "Losa alivianada de entrepiso con viguetas y carpeta de compresión de H°A° (e = 5 cm). Incluye encofrado inferior (apuntalamiento y tablones), losa alivianada por m² (viguetas + plastoformo/casetón + carpeta de compresión + armadura de reparto), y vigas perimetrales de H°A° con sección configurable (ancho y peralte). El área del entrepiso se define por largo y ancho. Se descuenta automáticamente el área ocupada por las vigas del cómputo de losa alivianada.",
      "inputsRequeridos": [
        {
          "nombre": "largo_losa",
          "label": "Largo del entrepiso",
          "unidad": "m",
          "default": 0.0
