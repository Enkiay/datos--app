          "presetNombre": "40×40×30",
          "computedOverrides": {
            "espesor": "h_zapata"
          },
          "catalogoCodigo": "UH006"
        },
        {
          "id": "cimiento",
          "nombre": "Cimiento corrido",
          "unidad": "m3",
          "formulaTexto": "longitud_total",
          "lee": [
            "longitud_total",
            "esquinas_efectivas",
            "cantidad_columnas",
            "h_zapata",
            "prof_zapata",
            "prof_zanja"
          ],
          "escribe": "ml_cimiento",
          "presetNombre": "40×40",
          "catalogoCodigo": "UH004",
          "descuentos": [
            {
              "nombre": "Esquinas",
              "factorFormula": "esquinas_efectivas",
              "overrides": {
                "largo": "0.40"
              }
            },
            {
              "nombre": "Zapatas (intersección)",
              "factorFormula": "if(prof_zapata <= prof_zanja, cantidad_columnas, 0)",
              "overrides": {
                "largo": "0.40",
                "alto": "h_zapata"
              }
            }
          ]
        },
        {
          "id": "columnas",
          "nombre": "Columna de H°A°",
          "unidad": "m3",
          "formulaTexto": "cantidad_columnas_layout",
          "lee": [
            "longitud_total",
            "separacion_columnas",
            "altura_muro",
            "h_sobrecimiento",
            "prof_zapata",
            "tipo_geometria",
            "lado_mayor",
            "cantidad_columnas_layout"
          ],
          "escribe": "cantidad_columnas",
          "presetNombre": "20×20",
          "computedOverrides": {
            "alto": "altura_muro + h_sobrecimiento + (prof_zapata - 0.05)"
          },
          "catalogoCodigo": "UH007"
        },
        {
          "id": "sobrecimiento",
          "nombre": "Sobrecimiento",
          "unidad": "m3",
          "formulaTexto": "longitud_total",
