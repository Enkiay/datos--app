{
  "version": 3.4,
  "plantillas": [
    {
      "id": "cerramiento-perimetral",
      "premium": false,
      "nombre": "Cerramiento Perimetral",
      "descripcion": "Muro perimetral de ladrillo de 6 huecos sobre cimiento corrido de H°C°. Geometría rectangular ortogonal definida por perímetro total y lado mayor (el lado menor se calcula automáticamente). Incluye excavación de zanjas (40×60 cm), capa de hormigón pobre (40×5 cm), cimiento corrido (40×40 cm), sobrecimiento (20×30 cm) y columnas de H°A° (20×20 cm). Las aberturas (portones vehiculares y puertas peatonales) descuentan automáticamente del muro y sobrecimiento; la fundación (excavación, H°P°, cimiento) continúa bajo las aberturas. Las columnas se distribuyen respetando las 4 esquinas obligatorias y la separación configurable (default 4 m).",
      "inputsRequeridos": [
        {
          "nombre": "longitud_total",
          "label": "Perímetro total (suma de lados)",
          "unidad": "m",
          "default": 40.0
        },
        {
          "nombre": "altura_muro",
          "label": "Altura del muro",
          "unidad": "m",
          "default": 2.5
        },
        {
          "nombre": "lado_mayor",
          "label": "Lado mayor",
          "unidad": "m",
          "default": 10.0
        }
      ],
      "parametrosEditables": [
        {
          "nombre": "numero_portones",
          "label": "Portones vehiculares",
          "unidad": "und",
          "default": 1.0,
          "min": 0.0,
          "max": 4.0
        },
        {
          "nombre": "ancho_porton",
          "label": "Ancho de portón",
          "unidad": "m",
          "default": 3.6,
          "min": 2.0,
          "max": 6.0
        },
        {
          "nombre": "alto_porton",
          "label": "Alto de portón",
          "unidad": "m",
          "default": 2.4,
          "min": 1.8,
          "max": 3.0
        },
        {
          "nombre": "numero_puertas",
          "label": "Puertas peatonales",
          "unidad": "und",
          "default": 1.0,
          "min": 0.0,
          "max": 6.0
        },
        {
          "nombre": "ancho_puerta",
          "label": "Ancho de puerta",
          "unidad": "m",
          "default": 1.0,
          "min": 0.7,
          "max": 1.2
        },
        {
          "nombre": "alto_puerta",
          "label": "Alto de puerta",
          "unidad": "m",
          "default": 2.1,
          "min": 1.8,
          "max": 2.5
        },
        {
          "nombre": "separacion_columnas",
          "label": "Separación entre columnas",
          "unidad": "m",
          "default": 4.0,
          "min": 2.0,
          "max": 6.0
        },
        {
          "nombre": "h_sobrecimiento",
          "label": "Altura sobrecimiento",
          "unidad": "m",
          "default": 0.3,
          "min": 0.2,
          "max": 0.6
        }
      ],
      "items": [
        {
          "id": "excavacion",
          "nombre": "Excavación de zanjas",
          "unidad": "m3",
          "formulaTexto": "longitud_total",
          "lee": [
            "longitud_total"
          ],
          "escribe": "ml_excavacion",
          "catalogoCodigo": "UH002",
          "presetNombre": "40×60",
          "descuentos": [
            {
              "nombre": "Esquinas",
              "factorFormula": "4",
              "overrides": {
                "largo": "0.40"
              }
            }
          ]
        },
        {
          "id": "hp_capa",
          "nombre": "Capa de hormigón pobre",
          "unidad": "m3",
          "formulaTexto": "longitud_total",
          "lee": [
            "longitud_total"
          ],
          "escribe": "ml_hp",
          "catalogoCodigo": "UH003",
          "presetNombre": "40×5cm",
          "descuentos": [
            {
              "nombre": "Esquinas",
              "factorFormula": "4",
              "overrides": {
                "largo": "0.40"
              }
            }
          ]
        },
        {
          "id": "cimiento",
          "nombre": "Cimiento corrido",
          "unidad": "m3",
          "formulaTexto": "longitud_total",
          "lee": [
            "longitud_total"
          ],
          "escribe": "ml_cimiento",
          "catalogoCodigo": "UH004",
          "presetNombre": "40×40",
          "descuentos": [
            {
              "nombre": "Esquinas",
              "factorFormula": "4",
              "overrides": {
                "largo": "0.40"
              }
            }
          ]
        },
        {
          "id": "columnas",
          "nombre": "Columna de H°A°",
          "unidad": "m3",
          "formulaTexto": "2*ceil(lado_mayor/separacion_columnas) + 2*ceil((longitud_total/2 - lado_mayor)/separacion_columnas)",
          "lee": [
            "longitud_total",
            "lado_mayor",
            "separacion_columnas",
            "altura_muro",
            "h_sobrecimiento"
          ],
          "escribe": "cantidad_columnas",
          "catalogoCodigo": "UH007",
          "presetNombre": "20×20",
          "computedOverrides": {
            "altura": "altura_muro + h_sobrecimiento"
          }
        },
        {
          "id": "sobrecimiento",
          "nombre": "Sobrecimiento",
          "unidad": "m3",
          "formulaTexto": "longitud_total",
          "lee": [
            "longitud_total",
            "numero_portones",
            "ancho_porton",
            "numero_puertas",
            "ancho_puerta"
          ],
          "escribe": "ml_sobrecimiento",
          "catalogoCodigo": "UH005",
          "presetNombre": "20×30",
          "computedOverrides": {
            "altura": "h_sobrecimiento"
          },
          "descuentos": [
            {
              "nombre": "Esquinas",
              "factorFormula": "4",
              "overrides": {
                "largo": "0.20"
              }
            },
            {
              "nombre": "Portones",
              "factorFormula": "numero_portones",
              "overrides": {
                "largo": "ancho_porton"
              }
            },
            {
              "nombre": "Puertas",
              "factorFormula": "numero_puertas",
              "overrides": {
                "largo": "ancho_puerta"
              }
            }
          ]
        },
        {
          "id": "muro",
          "nombre": "Muro de ladrillo 6H",
          "unidad": "m2",
          "formulaTexto": "longitud_total * altura_muro",
          "lee": [
            "longitud_total",
            "altura_muro",
            "cantidad_columnas",
            "numero_portones",
            "ancho_porton",
            "alto_porton",
            "numero_puertas",
            "ancho_puerta",
            "alto_puerta"
          ],
          "escribe": "area_muro",
          "catalogoCodigo": "UH009",
          "descuentos": [
            {
              "nombre": "Columnas",
              "factorFormula": "cantidad_columnas",
              "overrides": {
                "largo": "0.20",
                "ancho": "altura_muro"
              }
            },
            {
              "nombre": "Portones",
              "factorFormula": "numero_portones",
              "overrides": {
                "largo": "ancho_porton",
                "ancho": "min(alto_porton, altura_muro)"
              }
            },
            {
              "nombre": "Puertas",
              "factorFormula": "numero_puertas",
              "overrides": {
                "largo": "ancho_puerta",
                "ancho": "min(alto_puerta, altura_muro)"
              }
            }
          ]
        }
      ]
    }
  ]
}