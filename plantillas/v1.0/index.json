{
  "version": 3.3,
  "plantillas": [
    {
      "id": "cerramiento-perimetral",
      "premium": false,
      "nombre": "Cerramiento Perimetral",
      "descripcion": "Muro perimetral de ladrillo de 6 huecos sobre cimiento corrido de H°C°. Incluye excavación de zanjas (40×60 cm), capa de hormigón pobre (40×5 cm), cimiento corrido (40×40 cm), sobrecimiento (20×30 cm), zapatas de H°A° (40×40×30 cm) y columnas de H°A° (20×20 cm). Soporta aberturas para portones vehiculares y puertas peatonales: las aberturas descuentan automáticamente del muro y sobrecimiento; la fundación (excavación, H°P°, cimiento) continúa bajo las aberturas. Separación entre columnas configurable (2 a 6 m, default 4 m). El número de esquinas descuenta el solapamiento en las intersecciones de elementos lineales (default 4 para perímetro rectangular).",
      "inputsRequeridos": [
        {
          "nombre": "longitud_total",
          "label": "Longitud total del muro",
          "unidad": "m",
          "default": 0.0
        },
        {
          "nombre": "altura_muro",
          "label": "Altura del muro",
          "unidad": "m",
          "default": 2.5
        }
      ],
      "parametrosEditables": [
        {
          "nombre": "numero_portones",
          "label": "Portones vehiculares",
          "unidad": "und",
          "default": 1.0,
          "min": 0.0,
          "max": 4.0
        },
        {
          "nombre": "ancho_porton",
          "label": "Ancho de portón",
          "unidad": "m",
          "default": 3.6,
          "min": 2.0,
          "max": 6.0
        },
        {
          "nombre": "alto_porton",
          "label": "Alto de portón",
          "unidad": "m",
          "default": 2.4,
          "min": 1.8,
          "max": 3.0
        },
        {
          "nombre": "numero_puertas",
          "label": "Puertas peatonales",
          "unidad": "und",
          "default": 1.0,
          "min": 0.0,
          "max": 6.0
        },
        {
          "nombre": "ancho_puerta",
          "label": "Ancho de puerta",
          "unidad": "m",
          "default": 1.0,
          "min": 0.7,
          "max": 1.2
        },
        {
          "nombre": "alto_puerta",
          "label": "Alto de puerta",
          "unidad": "m",
          "default": 2.1,
          "min": 1.8,
          "max": 2.5
        },
        {
          "nombre": "numero_esquinas",
          "label": "Número de esquinas",
          "unidad": "und",
          "default": 4.0,
          "min": 0.0,
          "max": 20.0
        },
        {
          "nombre": "separacion_columnas",
          "label": "Separación entre columnas",
          "unidad": "m",
          "default": 4.0,
          "min": 2.0,
          "max": 6.0
        },
        {
          "nombre": "h_sobrecimiento",
          "label": "Altura sobrecimiento",
          "unidad": "m",
          "default": 0.3,
          "min": 0.2,
          "max": 0.6
        }
      ],
      "items": [
        {
          "id": "excavacion",
          "nombre": "Excavación de zanjas",
          "unidad": "m3",
          "formulaTexto": "longitud_total",
          "lee": [
            "longitud_total",
            "numero_esquinas"
          ],
          "escribe": "ml_excavacion",
          "catalogoCodigo": "UH002",
          "presetNombre": "40×60",
          "descuentos": [
            {
              "nombre": "Esquinas",
              "factorFormula": "numero_esquinas",
              "overrides": {
                "largo": "0.40"
              }
            }
          ]
        },
        {
          "id": "exc_zapatas",
          "nombre": "Excavación para zapatas",
          "unidad": "m3",
          "formulaTexto": "cantidad_columnas",
          "lee": [
            "cantidad_columnas"
          ],
          "escribe": "cant_exc_zapatas",
          "catalogoCodigo": "UH002",
          "parametrosItem": {
            "largo": 0.4,
            "ancho": 0.4,
            "profundidad": 0.3
          }
        },
        {
          "id": "hp_capa",
          "nombre": "Capa de hormigón pobre",
          "unidad": "m3",
          "formulaTexto": "longitud_total",
          "lee": [
            "longitud_total",
            "numero_esquinas"
          ],
          "escribe": "ml_hp",
          "catalogoCodigo": "UH003",
          "presetNombre": "40×5cm",
          "descuentos": [
            {
              "nombre": "Esquinas",
              "factorFormula": "numero_esquinas",
              "overrides": {
                "largo": "0.40"
              }
            }
          ]
        },
        {
          "id": "zapatas",
          "nombre": "Zapata de H°A°",
          "unidad": "m3",
          "formulaTexto": "cantidad_columnas",
          "lee": [
            "cantidad_columnas"
          ],
          "escribe": "cantidad_zapatas",
          "catalogoCodigo": "UH006",
          "presetNombre": "40×40×30"
        },
        {
          "id": "cimiento",
          "nombre": "Cimiento corrido",
          "unidad": "m3",
          "formulaTexto": "longitud_total",
          "lee": [
            "longitud_total",
            "numero_esquinas"
          ],
          "escribe": "ml_cimiento",
          "catalogoCodigo": "UH004",
          "presetNombre": "40×40",
          "descuentos": [
            {
              "nombre": "Esquinas",
              "factorFormula": "numero_esquinas",
              "overrides": {
                "largo": "0.40"
              }
            }
          ]
        },
        {
          "id": "columnas",
          "nombre": "Columna de H°A°",
          "unidad": "m3",
          "formulaTexto": "ceil(longitud_total / separacion_columnas)",
          "lee": [
            "longitud_total",
            "separacion_columnas",
            "altura_muro",
            "h_sobrecimiento"
          ],
          "escribe": "cantidad_columnas",
          "catalogoCodigo": "UH007",
          "presetNombre": "20×20",
          "computedOverrides": {
            "altura": "altura_muro + h_sobrecimiento"
          }
        },
        {
          "id": "sobrecimiento",
          "nombre": "Sobrecimiento",
          "unidad": "m3",
          "formulaTexto": "longitud_total",
          "lee": [
            "longitud_total",
            "numero_esquinas",
            "numero_portones",
            "ancho_porton",
            "numero_puertas",
            "ancho_puerta"
          ],
          "escribe": "ml_sobrecimiento",
          "catalogoCodigo": "UH005",
          "presetNombre": "20×30",
          "computedOverrides": {
            "altura": "h_sobrecimiento"
          },
          "descuentos": [
            {
              "nombre": "Esquinas",
              "factorFormula": "numero_esquinas",
              "overrides": {
                "largo": "0.20"
              }
            },
            {
              "nombre": "Portones",
              "factorFormula": "numero_portones",
              "overrides": {
                "largo": "ancho_porton"
              }
            },
            {
              "nombre": "Puertas",
              "factorFormula": "numero_puertas",
              "overrides": {
                "largo": "ancho_puerta"
              }
            }
          ]
        },
        {
          "id": "muro",
          "nombre": "Muro de ladrillo 6H",
          "unidad": "m2",
          "formulaTexto": "longitud_total * altura_muro",
          "lee": [
            "longitud_total",
            "altura_muro",
            "cantidad_columnas",
            "numero_portones",
            "ancho_porton",
            "alto_porton",
            "numero_puertas",
            "ancho_puerta",
            "alto_puerta"
          ],
          "escribe": "area_muro",
          "catalogoCodigo": "UH009",
          "descuentos": [
            {
              "nombre": "Columnas",
              "factorFormula": "cantidad_columnas",
              "overrides": {
                "largo": "0.20",
                "ancho": "altura_muro"
              }
            },
            {
              "nombre": "Portones",
              "factorFormula": "numero_portones",
              "overrides": {
                "largo": "ancho_porton",
                "ancho": "min(alto_porton, altura_muro)"
              }
            },
            {
              "nombre": "Puertas",
              "factorFormula": "numero_puertas",
              "overrides": {
                "largo": "ancho_puerta",
                "ancho": "min(alto_puerta, altura_muro)"
              }
            }
          ]
        }
      ]
    }
  ]
}