                "ancho": "0.20",
                "altura": "h_sobrecimiento"
              }
            }
          ]
        },
        {
          "id": "muro",
          "nombre": "Muro de ladrillo 6H",
          "unidad": "m2",
          "formulaTexto": "longitud_total",
          "lee": [
            "longitud_total",
            "altura_muro",
            "h_sobrecimiento",
            "cantidad_columnas",
            "numero_portones",
            "ancho_porton",
            "alto_porton",
            "n_puertas_efectivo",
            "ancho_puerta",
            "alto_puerta"
          ],
          "escribe": "area_muro",
          "computedOverrides": {
            "largo": "1",
            "alto": "altura_muro - h_sobrecimiento"
          },
          "catalogoCodigo": "UH009",
          "descuentos": [
            {
              "nombre": "Columnas",
              "factorFormula": "cantidad_columnas",
              "overrides": {
                "largo": "0.20",
                "alto": "altura_muro - h_sobrecimiento"
              }
            },
            {
              "nombre": "Portones",
              "factorFormula": "numero_portones",
              "overrides": {
                "largo": "ancho_porton",
                "alto": "max(0, min(alto_porton - h_sobrecimiento, altura_muro - h_sobrecimiento))"
              }
            },
            {
              "nombre": "Puertas",
              "factorFormula": "n_puertas_efectivo",
              "overrides": {
                "largo": "ancho_puerta",
                "alto": "max(0, min(alto_puerta - h_sobrecimiento, altura_muro - h_sobrecimiento))"
              }
            }
          ]
        }
      ],
      "variablesCalculadas": {
        "esquinas_implicitas": "if(tipo_geometria == 1, 0, if(tipo_geometria == 2, 1, if(tipo_geometria == 3, 2, if(tipo_geometria == 4, 4, 0))))",
        "esquinas_efectivas": "esquinas_implicitas + esquinas_extra",
        "extremos_abiertos": "if(or(tipo_geometria == 4, tipo_geometria == 5), 0, 1)",
        "sep_max": "separacion_columnas * 1.15",
        "_ay_default_geom": "if(tipo_geometria == 1, 0, if(tipo_geometria == 2, longitud_total / 2, if(tipo_geometria == 3, longitud_total / 3, longitud_total / 4)))",
        "_ay_pre": "if(lado_mayor > 0, lado_mayor, _ay_default_geom)",
        "_ax_pre": "if(tipo_geometria == 1, longitud_total, if(tipo_geometria == 2, longitud_total - _ay_pre, if(tipo_geometria == 3, longitud_total - 2 * _ay_pre, if(tipo_geometria == 4, longitud_total / 2 - _ay_pre, longitud_total / 4))))",
        "_swap_lados": "if(and(or(tipo_geometria == 2, tipo_geometria == 4), _ax_pre > _ay_pre), 1, 0)",
        "layout_ancho_x": "if(_swap_lados == 1, _ay_pre, _ax_pre)",
        "layout_alto_y": "if(_swap_lados == 1, _ax_pre, _ay_pre)",
        "n_puertas_efectivo": "if(layout_ancho_x >= 8, numero_puertas, 0)",
        "espacio_aberturas": "numero_portones * ancho_porton + n_puertas_efectivo * ancho_puerta",
        "n_tramos_libres": "if(and(numero_portones == 0, n_puertas_efectivo == 0), 1, if(n_puertas_efectivo == 0, 1, 2))",
        "tramo_libre_total": "max(0, layout_ancho_x - espacio_aberturas)",
        "tramo_libre_promedio": "tramo_libre_total / n_tramos_libres",
        "intermedios_por_tramo": "if(tramo_libre_promedio > sep_max, ceil(tramo_libre_promedio / sep_max) - 1, 0)",
        "intermedios_bottom": "n_tramos_libres * intermedios_por_tramo",
        "jambas_aberturas": "if(numero_portones > 0, 1, 0) + 2 * n_puertas_efectivo",
        "columnas_extremos_quitar": "if(tipo_geometria == 1, max(0, 2 - columnas_en_extremos), if(tipo_geometria == 2, max(0, 1 - columnas_en_extremos), 0))",
        "layout_cols_bottom": "2 + jambas_aberturas + intermedios_bottom",
        "layout_cols_top": "if(or(tipo_geometria == 4, tipo_geometria == 5), ceil(layout_ancho_x / sep_max) + 1, 0)",
        "layout_inter_side": "if(layout_alto_y > sep_max, ceil(layout_alto_y / sep_max) - 1, 0)",
        "layout_lados_verticales": "if(tipo_geometria == 1, 0, if(tipo_geometria == 2, 1, 2))",
        "cantidad_columnas_layout": "max(0, layout_cols_top + layout_cols_bottom + layout_lados_verticales * layout_inter_side - columnas_extremos_quitar)"
      }
    },
